# Copie para .env (na raiz do projeto, na LXC) e preencha.
#   cp .env.example .env && chmod 600 .env
# O .env está no .gitignore: nunca commite credenciais.

# Login do Brudam
BRUDAM_USER=
BRUDAM_PASS=

# Postgres ares_bi (de preferência pelo IP interno da LXC do banco)
DB_HOST=
DB_PORT=5432
DB_NAME=ares_bi
DB_USER=
DB_PASSWORD=

# Notificações Ntfy (usuário:senha)
NTFY_AUTH=

# Identificação desta máquina no histórico de execuções (opcional)
PREDATOR_HOST=lxc-ares-predator
